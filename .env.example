# Database
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz
POSTGRES_DB=quiz
DATABASE_URL=postgresql://quiz:quiz@db:5432/quiz

# JWT secrets
JWT_SECRET=change_me
